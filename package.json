{
  "name": "gitlab-compliance-integration",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/server", "apps/web"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "predev:server": "node scripts/check-node.mjs",
    "dev:server": "npm run dev --workspace @zania/server",
    "predev:web": "node scripts/check-node.mjs",
    "dev:web": "npm run dev --workspace @zania/web",
    "prebuild": "node scripts/check-node.mjs",
    "build": "npm run build --workspace @zania/server && npm run build --workspace @zania/web",
    "pretest": "node scripts/check-node.mjs",
    "test": "npm run test --workspace @zania/server",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
